@@ -0,0 +1,106 @@
+"""Reproducible generation benchmark on THIS machine. Writes docs/results/gen_bench_<kind>.json + sample frames.
+
+    python scripts/bench_generation.py image [candidate ...]
+    python scripts/bench_generation.py video [candidate ...]
+
+Every number in docs/GENERATION.md comes from this script; nothing is copied from model cards."""
+from __future__ import annotations
+
+import gc
+import json
+import platform
+import resource
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+from nexus import config  # noqa: E402
+
+OUT = ROOT / "docs" / "results"
+SAMPLES = config.HOME / "bench" / "generation"
+PROMPTS = {
+    "scene": "cinematic wide shot of a small solar-powered research boat in a foggy harbor at dawn, volumetric light, film still, 35mm",
+    "character": "portrait of a weathered retired sea captain, grey beard, navy wool sweater, harbor background, cinematic lighting, film still",
+    "concept": "microscopic view of immune cells attacking a virus, scientific illustration, vivid, detailed, dramatic lighting",
+}
+NEG = "blurry, low quality, deformed, text, watermark, extra fingers"
+
+
+def rss_gb() -> float:
+    return round(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / (1024 ** 2 if platform.system() != "Darwin" else 1024 ** 3), 2)
+
+
+def sharpness(img) -> float:
+    import numpy as np
+    g = np.asarray(img.convert("L"), dtype="float32")
+    lap = g[1:-1, 1:-1] * 4 - g[:-2, 1:-1] - g[2:, 1:-1] - g[1:-1, :-2] - g[1:-1, 2:]
+    return round(float(lap.var()), 1)
+
+
+def bench_image(names: list[str]) -> None:
+    from nexus.generate import image as gi
+    rows = []
+    for name in names or list(gi.CANDIDATES):
+        spec = gi.CANDIDATES[name]
+        t0 = time.time()
+        try:
+            pipe = gi.load(name)
+        except Exception as e:
+            rows.append({"candidate": name, "error": f"{type(e).__name__}: {str(e)[:200]}"})
+            continue
+        load_s = round(time.time() - t0, 1)
+        for res in spec["bench_sizes"]:
+            times, sharp = [], []
+            for key, prompt in PROMPTS.items():
+                t = time.time()
+                img = gi.run(pipe, name, prompt, NEG, res[0], res[1], seed=7)
+                times.append(round(time.time() - t, 1))
+                sharp.append(sharpness(img))
+                d = SAMPLES / "image"
+                d.mkdir(parents=True, exist_ok=True)
+                img.save(d / f"{name}_{res[0]}x{res[1]}_{key}.jpg", quality=90)
+            rows.append({"candidate": name, "repo": spec["repo"], "license": spec["license"], "size": f"{res[0]}x{res[1]}", "steps": spec["steps"],
+                         "load_s": load_s, "seconds_per_image": times, "mean_s": round(sum(times) / len(times), 1),
+                         "sharpness": sharp, "peak_rss_gb": rss_gb()})
+            print(rows[-1], flush=True)
+        del pipe
+        gc.collect()
+    _save("image", rows)
+
+
+def bench_video(names: list[str]) -> None:
+    from nexus.generate import video as gv
+    rows = []
+    for name in names or list(gv.CANDIDATES):
+        spec = gv.CANDIDATES[name]
+        for res in spec["bench_sizes"]:
+            t0 = time.time()
+            try:
+                d = SAMPLES / "video"
+                d.mkdir(parents=True, exist_ok=True)
+                out = d / f"{name}_{res[0]}x{res[1]}.mp4"
+                info = gv.generate(PROMPTS["scene"] + ", slow camera push in, gentle waves", out, name=name, width=res[0], height=res[1], seed=7)
+                rows.append({"candidate": name, "repo": spec["repo"], "license": spec["license"], "size": f"{res[0]}x{res[1]}", **info,
+                             "total_s": round(time.time() - t0, 1), "peak_rss_gb": rss_gb()})
+            except Exception as e:
+                rows.append({"candidate": name, "size": f"{res[0]}x{res[1]}", "error": f"{type(e).__name__}: {str(e)[:300]}", "peak_rss_gb": rss_gb()})
+            print(rows[-1], flush=True)
+            gc.collect()
+    _save("video", rows)
+
+
+def _save(kind: str, rows: list[dict]) -> None:
+    import psutil
+    import torch
+    f = OUT / f"gen_bench_{kind}.json"
+    old = json.loads(f.read_text())["results"] if f.exists() else []
+    keep = [r for r in old if (r["candidate"], r.get("size")) not in {(x["candidate"], x.get("size")) for x in rows}]
+    f.write_text(json.dumps({"machine": {"cpu_threads": psutil.cpu_count(), "ram_gb": round(psutil.virtual_memory().total / 2 ** 30, 1), "gpu": None,
+                                         "torch": torch.__version__, "os": platform.system()},
+                             "date": time.strftime("%Y-%m-%d"), "prompts": PROMPTS, "results": keep + rows}, indent=1) + "\n")
+
+
+if __name__ == "__main__":
+    {"image": bench_image, "video": bench_video}[sys.argv[1]](sys.argv[2:])
