index 0000000..8933d4b
--- /dev/null
+++ b/nexus/generate/shots.py
@@ -0,0 +1,150 @@
+"""Visual direction: turn a scene into one or more SHOTS (image + camera move) and render them as a scene video.
+
+A scene is no longer one still with a zoom. It gets a shot list - e.g. a wide establishing shot that pushes in, then a
+closer shot that pans - each rendered with real depth parallax. Images come from licensed stock (factual content,
+when a match exists) or the local image model; every shot keeps a provenance record."""
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+from .. import config
+
+# Look presets: how prompts are finished, which camera moves are used, grade and music mood.
+STYLES: dict[str, dict] = {
+    "cinematic": {"suffix": "cinematic film still, dramatic lighting, shallow depth of field, anamorphic, highly detailed", "moves": ["push_in", "pan_right", "orbit", "pull_out"],
+                  "grade": "cinematic", "mood": "tense"},
+    "documentary": {"suffix": "documentary photograph, natural light, realistic, 35mm, detailed", "moves": ["pan_right", "push_in", "pan_left", "rise"],
+                    "grade": "documentary", "mood": "documentary"},
+    "educational": {"suffix": "clean editorial illustration, bright even lighting, clear subject, detailed", "moves": ["push_in", "pan_right", "pull_out", "pan_left"],
+                    "grade": "none", "mood": "inspiring"},
+    "scientific": {"suffix": "scientific visualization, macro photography, precise, detailed, dark background, vivid", "moves": ["push_in", "orbit", "pull_out", "rise"],
+                   "grade": "cinematic", "mood": "calm"},
+    "commercial": {"suffix": "premium product photography, studio lighting, glossy, clean background, sharp", "moves": ["orbit", "push_in", "pan_left", "pull_out"],
+                   "grade": "vivid", "mood": "upbeat"},
+    "storytelling": {"suffix": "storybook concept art, painterly, warm light, atmospheric, detailed", "moves": ["push_in", "pan_left", "rise", "pull_out"],
+                     "grade": "warm", "mood": "calm"},
+    "social": {"suffix": "bold vibrant photograph, high contrast, eye-catching, sharp", "moves": ["push_in", "orbit", "pan_right", "push_in"],
+               "grade": "vivid", "mood": "upbeat"},
+    "explainer": {"suffix": "modern flat illustration, simple shapes, soft gradient background, clear subject", "moves": ["push_in", "pan_right", "pull_out", "pan_left"],
+                  "grade": "none", "mood": "inspiring"},
+    "film": {"suffix": "cinematic film still, moody lighting, shallow depth of field, 35mm film grain, highly detailed", "moves": ["push_in", "pan_left", "orbit", "pull_out"],
+             "grade": "cinematic", "mood": "tense"},
+}
+SHOT_SIZES = {"wide": "wide establishing shot of", "medium": "medium shot of", "close": "close-up of", "detail": "macro detail shot of"}
+GEN_SIZE = (768, 432)  # measured on 4 CPU threads: ~33 s per image (docs/results/gen_bench_image.json)
+
+
+def available() -> bool:
+    """Generated visuals need torch + diffusers; without them NEXUS falls back to stock stills."""
+    try:
+        import cv2  # noqa: F401
+        import diffusers  # noqa: F401
+        import torch  # noqa: F401
+        return True
+    except ImportError:
+        return False
+
+
+def style(name: str | None) -> dict:
+    return STYLES.get(name or "cinematic", STYLES["cinematic"])
+
+
+def prompt_for(subject: str, shot: str = "wide", style_name: str | None = None, extra: str = "") -> str:
+    parts = [f"{SHOT_SIZES.get(shot, shot)} {subject.strip().rstrip('.')}", extra.strip(), style(style_name)["suffix"]]
+    return ", ".join(p for p in parts if p)
+
+
+def render_scene(shots: list[dict], out: Path, duration: float, size: tuple[int, int] = (1280, 720), fps: int = config.FPS) -> dict:
+    """shots: [{"image": path, "move": str}] -> one video of exactly `duration` seconds, hard cuts between shots."""
+    from . import video
+    out = Path(out)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    if len(shots) == 1 and not shots[0].get("video"):
+        return video.parallax(shots[0]["image"], out, move=shots[0]["move"], seconds=duration, size=size, fps=fps)
+    # a shot that is already a generated moving clip keeps its own length; the camera-move shots share the rest
+    fixed = sum(s["seconds"] for s in shots if s.get("video"))
+    per = max(1.5, (duration - fixed) / max(1, sum(1 for s in shots if not s.get("video"))))
+    parts, keep = [], []
+    for i, s in enumerate(shots):
+        if s.get("video"):
+            parts.append(Path(s["video"]))
+            keep.append(Path(s["video"]))
+            continue
+        part = out.with_name(f"{out.stem}_shot{i}.mp4")
+        video.parallax(s["image"], part, move=s["move"], seconds=per, size=size, fps=fps)
+        parts.append(part)
+    lst = out.with_suffix(".txt")
+    lst.write_text("".join(f"file '{p.as_posix()}'\n" for p in parts))
+    r = subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-f", "concat", "-safe", "0", "-i", str(lst), "-c", "copy", str(out)], capture_output=True, text=True)
+    if r.returncode != 0:
+        raise RuntimeError(f"could not join shots: {r.stderr[-300:]}")
+    for p in [*parts, lst]:
+        if p not in keep:
+            p.unlink(missing_ok=True)
+    return {"path": str(out), "shots": len(shots), "seconds": duration, "motion": video.motion_score(out)}
+
+
+def can_generate_motion() -> bool:
+    """Text-to-video on CPU peaks at ~11 GB of RAM (measured); do not attempt it on a smaller machine."""
+    import psutil
+    return psutil.virtual_memory().total / 2 ** 30 >= 14
+
+
+def director(project, style_name: str | None = None, mode: str = "auto", size: tuple[int, int] = (1280, 720), seed: int = 7, motion_shots: int = 0):
+    """Returns visual_fn(i, scene, dur, used) for create.produce.
+
+    mode: "auto"      licensed stock photo when one matches the scene (factual content), generated image otherwise
+          "generated" always the local image model
+    Long scenes (> 9 s of narration) get two shots: the main image, then a generated closer shot of the same subject.
+    motion_shots: the first N scenes open with a real generated moving clip (text-to-video, ~2 s) before the camera-move shots."""
+    from .. import assets
+    from . import image as gi
+    st = style(style_name)
+    wdir = project.dir / "work" / "shots"
+
+    def visual(i: int, scene: dict, dur: float, used: set) -> dict | None:
+        subject = scene.get("visual_prompt") or scene.get("visual_query") or scene.get("on_screen_text")
+        close_subject = scene.get("visual_query") or subject
+        if not subject:
+            return None
+        shots, provs = [], []
+        if i < motion_shots and can_generate_motion():
+            from .. import llm
+            from . import video
+            llm.unload()  # the video model needs the RAM the language model is holding
+            gi.unload()
+            v = video.generate(prompt_for(subject, "wide", style_name) + ", bright, clear subject, slow camera movement, gentle motion", wdir / f"scene{i:02d}_motion.mp4",
+                               seed=seed + 500 + i, out_size=size)
+            video.unload()
+            shots.append({"video": v["path"], "seconds": v["clip_seconds"], "kind": "generated-video", "move": "generated motion", "image": None})
+            provs.append(v)
+        row = None
+        if mode == "auto" and scene.get("visual_query"):
+            # a photo is used only when its title is really about the scene; otherwise a generated picture is more relevant
+            row = assets.find_image(scene["visual_query"], project.id, used, fallbacks=(scene.get("on_screen_text", ""),), min_relevance=0.5)
+        if row:
+            used.add(row["id"])
+            shots.append({"image": row["path"], "kind": "stock"})
+            provs.append({"license": row["license"], "source": row["source"], "attribution": row["attribution"], "matched_query": row.get("matched_query"),
+                          "relevance": row.get("relevance")})
+        else:
+            g = gi.generate(prompt_for(subject, "wide", style_name), wdir / f"scene{i:02d}_a.jpg", width=GEN_SIZE[0], height=GEN_SIZE[1], seed=seed + i)
+            shots.append({"image": g["path"], "kind": "generated"})
+            provs.append(g)
+        if dur > 9.0:  # second shot: closer, same subject, different seed -> visual variety inside the scene
+            # the second shot is a detail of the SAME subject ("close-up" alone makes the model draw a face)
+            g = gi.generate(prompt_for(subject, "detail", style_name, f"focus on {close_subject}"), wdir / f"scene{i:02d}_b.jpg", width=GEN_SIZE[0], height=GEN_SIZE[1], seed=seed + 100 + i)
+            shots.append({"image": g["path"], "kind": "generated"})
+            provs.append(g)
+        for k, s in enumerate(shots):
+            s.setdefault("move", st["moves"][(i * 2 + k) % len(st["moves"])])
+        out = wdir / f"scene{i:02d}.mp4"
+        info = render_scene(shots, out, dur, size)
+        kinds = sorted({s["kind"] for s in shots})
+        return {"video": str(out), "frames": [s["image"] for s in shots if s.get("image")], "shots": shots, "motion": info["motion"],
+                "provenance": {"license": "; ".join(sorted({p["license"] for p in provs})), "source": " + ".join(kinds) + " image(s), depth-parallax camera move",
+                               "shots": [{"kind": s["kind"], "move": s["move"], **{k: v for k, v in p.items() if k in ("attribution", "model", "prompt", "seed", "matched_query", "relevance")}}
+                                         for s, p in zip(shots, provs)]}}
+
+    return visual
