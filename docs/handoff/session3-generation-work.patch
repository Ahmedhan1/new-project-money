index 0000000..7b28358
--- /dev/null
+++ b/nexus/generate/video.py
@@ -0,0 +1,197 @@
+"""Local video generation that really runs on a CPU-only machine.
+
+Two different things, named honestly:
+  * `generate()`  - text-to-video with a distilled AnimateDiff motion model (few steps). Real generated motion,
+                    short (2 s) and low resolution on CPU; upscaled + frame-interpolated for the timeline.
+  * `parallax()`  - a 2.5D camera move (push-in / pan / orbit) from ONE still using a monocular depth map.
+                    Real camera movement with depth parallax, not generated subject motion.
+
+Large text/image-to-video models (Wan, LTX, CogVideoX, HunyuanVideo) need a GPU: they are described in
+registry/genmodels.yaml and routed by nexus.generate.select to a GPU worker when one is authorised."""
+from __future__ import annotations
+
+import hashlib
+import subprocess
+import time
+from pathlib import Path
+
+from .. import config, costguard, db
+from . import image as gi
+
+CANDIDATES: dict[str, dict] = {
+    "animatediff-lightning-4step": {"repo": "ByteDance/AnimateDiff-Lightning", "file": "animatediff_lightning_4step_diffusers.safetensors",
+                                    "base": "Lykon/dreamshaper-8", "license": "CreativeML OpenRAIL-M (motion model + base)", "steps": 4,
+                                    "frames": 16, "fps": 8, "bench_sizes": [(384, 216), (512, 288)]},
+}
+_pipe: dict = {}
+
+
+def _load(name: str):
+    costguard.authorize("diffusers-local", f"load {name}")
+    import torch
+    from diffusers import AnimateDiffPipeline, EulerDiscreteScheduler, MotionAdapter
+    from huggingface_hub import hf_hub_download
+    from safetensors.torch import load_file
+    spec = CANDIDATES[name]
+    dev = gi.device()
+    dtype = torch.float16 if dev == "cuda" else torch.float32
+    adapter = MotionAdapter().to(dev, dtype)
+    adapter.load_state_dict(load_file(hf_hub_download(spec["repo"], spec["file"], cache_dir=gi.hf_cache()), device=dev))
+    pipe = AnimateDiffPipeline.from_pretrained(spec["base"], motion_adapter=adapter, torch_dtype=dtype, variant="fp16", cache_dir=gi.hf_cache())
+    pipe.scheduler = EulerDiscreteScheduler.from_config(pipe.scheduler.config, timestep_spacing="trailing", beta_schedule="linear")
+    pipe.to(dev)
+    pipe.set_progress_bar_config(disable=True)
+    if dev == "cpu":  # 16 frames of temporal attention in float32: without slicing, 512x288 exceeds 16 GB of RAM
+        for obj, meth, arg in ((pipe.vae, "enable_slicing", ()), (pipe, "enable_attention_slicing", ("max",))):
+            if hasattr(obj, meth):  # names moved between diffusers releases
+                getattr(obj, meth)(*arg)
+    return pipe
+
+
+def _encode(frames, out: Path, src_fps: int, size: tuple[int, int] | None, fps: int = config.FPS) -> None:
+    """PIL frames -> H.264. Low-fps model output is motion-interpolated to the timeline frame rate."""
+    w, h = frames[0].size
+    vf = [f"minterpolate=fps={fps}:mi_mode=mci:mc_mode=aobmc:vsbmc=1"] if src_fps < fps else []
+    if size and size != (w, h):
+        vf.append(f"scale={size[0]}:{size[1]}:flags=lanczos")
+    cmd = ["ffmpeg", "-loglevel", "error", "-y", "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", f"{w}x{h}", "-r", str(src_fps), "-i", "-",
+           *(["-vf", ",".join(vf)] if vf else []), "-r", str(fps), *config.VCODEC, "-an", str(out)]
+    p = subprocess.Popen(cmd, stdin=subprocess.PIPE)
+    for f in frames:
+        p.stdin.write(f.convert("RGB").tobytes())
+    p.stdin.close()
+    if p.wait() != 0:
+        raise RuntimeError("ffmpeg failed while encoding generated frames")
+
+
+def motion_score(path: str | Path, samples: int = 12) -> float:
+    """Mean absolute luma difference between consecutive sampled frames (0 = frozen picture)."""
+    import numpy as np
+    r = subprocess.run(["ffmpeg", "-loglevel", "error", "-i", str(path), "-vf", f"fps={samples}/2,scale=160:90,format=gray", "-t", "2",
+                        "-f", "rawvideo", "-"], capture_output=True)
+    a = np.frombuffer(r.stdout, dtype=np.uint8)
+    n = len(a) // (160 * 90)
+    if n < 2:
+        return 0.0
+    f = a[: n * 160 * 90].reshape(n, 90, 160).astype("float32")
+    return round(float(np.abs(f[1:] - f[:-1]).mean()), 2)
+
+
+def generate(prompt: str, out: Path, *, name: str = "animatediff-lightning-4step", width: int = 512, height: int = 288, seed: int = 0,
+             out_size: tuple[int, int] | None = (1280, 720), negative: str = gi.NEGATIVE) -> dict:
+    """Text-to-video clip. Cached by (model, prompt, size, seed)."""
+    import torch
+    spec = CANDIDATES[name]
+    out = Path(out)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    key = hashlib.sha256(f"{name}|{prompt}|{width}x{height}|{seed}|{out_size}".encode()).hexdigest()[:20]
+    cache = config.CACHE / "genvid" / f"{key}.mp4"
+    t0 = time.time()
+    gen_s = None
+    if not cache.exists():
+        if name not in _pipe:
+            gi.unload()
+            _pipe.clear()
+            _pipe[name] = _load(name)
+        load_s = round(time.time() - t0, 1)
+        t1 = time.time()
+        with torch.inference_mode():
+            frames = _pipe[name](prompt=prompt, guidance_scale=1.0, num_inference_steps=spec["steps"], num_frames=spec["frames"], width=width,
+                                 height=height, generator=torch.Generator("cpu").manual_seed(seed)).frames[0]
+        gen_s = round(time.time() - t1, 1)
+        cache.parent.mkdir(parents=True, exist_ok=True)
+        _encode(frames, cache, spec["fps"], out_size)
+        db.metric("genvid_seconds", gen_s, model=name, size=f"{width}x{height}", frames=spec["frames"], load=load_s)
+    out.write_bytes(cache.read_bytes())
+    return {"path": str(out), "license": "generated by NEXUS (original output)", "source": f"local video model {name}", "model": spec["repo"],
+            "model_license": spec["license"], "prompt": prompt, "seed": seed, "frames": spec["frames"], "native_fps": spec["fps"],
+            "clip_seconds": round(spec["frames"] / spec["fps"], 2), "generate_s": gen_s, "motion": motion_score(out)}
+
+
+def unload() -> None:
+    import gc
+    _pipe.clear()
+    _depth.clear()
+    gc.collect()
+
+
+# ----------------------------------------------------------------- 2.5D camera move from a still
+_depth: dict = {}
+MOVES = ("push_in", "pull_out", "pan_left", "pan_right", "rise", "orbit")
+
+
+def depth_map(img):
+    """Relative depth (1 = near, 0 = far) from Depth Anything V2 Small (Apache-2.0, ~25 M parameters, CPU-friendly)."""
+    costguard.authorize("diffusers-local", "depth")
+    import numpy as np
+    if "p" not in _depth:
+        from transformers import pipeline
+        _depth["p"] = pipeline("depth-estimation", model="depth-anything/Depth-Anything-V2-Small-hf", model_kwargs={"cache_dir": gi.hf_cache()})
+    d = np.asarray(_depth["p"](img)["depth"].resize(img.size), dtype="float32")
+    d = (d - d.min()) / max(float(d.max() - d.min()), 1e-6)
+    return d
+
+
+def parallax(image_path: str | Path, out: Path, *, move: str = "push_in", seconds: float = 4.0, size: tuple[int, int] = (1280, 720),
+             strength: float = 1.0, fps: int = config.FPS) -> dict:
+    """Render a camera move over a still. Near pixels travel further than far ones, so the shot has real parallax
+    instead of the flat zoom of a Ken Burns effect."""
+    import cv2
+    import numpy as np
+    from PIL import Image
+    t0 = time.time()
+    W, H = size
+    with Image.open(image_path) as im:
+        im = im.convert("RGB")
+        s = max(W / im.width, H / im.height) * 1.12  # overscan so warped edges never show
+        im = im.resize((int(im.width * s) + 1, int(im.height * s) + 1), Image.LANCZOS)
+        l, t = (im.width - int(W * 1.12)) // 2, (im.height - int(H * 1.12)) // 2
+        im = im.crop((l, t, l + int(W * 1.12), t + int(H * 1.12)))
+    src = np.asarray(im)
+    # generated images are upscaled from 768 px: restore edge contrast once, before any frame is warped
+    src = cv2.addWeighted(src, 1.45, cv2.GaussianBlur(src, (0, 0), 1.6), -0.45, 0)
+    h, w = src.shape[:2]
+    depth = cv2.GaussianBlur(depth_map(im.resize((w // 2, h // 2))), (0, 0), 3)
+    depth = cv2.resize(depth, (w, h), interpolation=cv2.INTER_LINEAR) - 0.5  # centred: mid-distance stays put
+    yy, xx = np.mgrid[0:h, 0:w].astype("float32")
+    cx, cy = w / 2, h / 2
+    n = max(2, int(seconds * fps))
+    amp = 0.03 * w * strength
+    out = Path(out)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    p = subprocess.Popen(["ffmpeg", "-loglevel", "error", "-y", "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", f"{W}x{H}", "-r", str(fps), "-i", "-",
+                          *config.VCODEC, "-an", str(out)], stdin=subprocess.PIPE)
+    for i in range(n):
+        u = i / (n - 1)
+        e = u * u * (3 - 2 * u)  # ease in/out
+        a = e - 0.5
+        dx = dy = 0.0
+        zoom = 1.0
+        if move == "push_in":
+            zoom = 1.0 + 0.14 * e * strength
+        elif move == "pull_out":
+            zoom = 1.0 + 0.14 * (1 - e) * strength
+        elif move == "pan_left":
+            dx = 2 * a * amp
+        elif move == "pan_right":
+            dx = -2 * a * amp
+        elif move == "rise":
+            dy = 2 * a * amp * 0.7
+        elif move == "orbit":
+            dx, zoom = 2.4 * a * amp, 1.0 + 0.05 * float(np.sin(np.pi * u)) * strength
+        else:
+            raise ValueError(f"unknown camera move {move}")
+        # zoom is depth-dependent too: near objects grow faster than the background during a push-in
+        z = zoom + (zoom - 1.0) * 1.6 * depth
+        mx = cx + (xx - cx) / z + dx * depth * 2
+        my = cy + (yy - cy) / z + dy * depth * 2
+        frame = cv2.remap(src, mx.astype("float32"), my.astype("float32"), cv2.INTER_LINEAR, borderMode=cv2.BORDER_REFLECT)
+        y0, x0 = (h - H) // 2, (w - W) // 2
+        p.stdin.write(frame[y0:y0 + H, x0:x0 + W].tobytes())
+    p.stdin.close()
+    if p.wait() != 0:
+        raise RuntimeError("ffmpeg failed while encoding the camera move")
+    el = round(time.time() - t0, 2)
+    db.metric("parallax_seconds", el, move=move, seconds=seconds)
+    return {"path": str(out), "move": move, "seconds": seconds, "render_s": el, "motion": motion_score(out),
+            "technique": "2.5D depth parallax (Depth Anything V2 Small, Apache-2.0)"}
