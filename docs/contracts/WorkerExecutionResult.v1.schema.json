{
 "$defs": {
  "ArtifactLocation": {
   "additionalProperties": false,
   "description": "Where one copy of an artifact lives. `provider` is a StorageProvider id; `connection_id` names the authorised\naccount (e.g. drive_a) - never a credential.",
   "properties": {
    "provider": {
     "title": "Provider",
     "type": "string"
    },
    "connection_id": {
     "title": "Connection Id",
     "type": "string"
    },
    "ref": {
     "description": "provider-native id or key (Drive file id, object key, local relative path)",
     "title": "Ref",
     "type": "string"
    },
    "path": {
     "default": "",
     "description": "human-readable path, e.g. NEXUS/Masters/prj_x/master.mp4",
     "title": "Path",
     "type": "string"
    },
    "verified_at": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Verified At"
    }
   },
   "required": [
    "provider",
    "connection_id",
    "ref"
   ],
   "title": "ArtifactLocation",
   "type": "object"
  },
  "ArtifactManifest": {
   "additionalProperties": false,
   "properties": {
    "contract": {
     "const": "ArtifactManifest/v1",
     "default": "ArtifactManifest/v1",
     "title": "Contract",
     "type": "string"
    },
    "artifact_id": {
     "title": "Artifact Id",
     "type": "string"
    },
    "kind": {
     "enum": [
      "source",
      "proxy",
      "analysis",
      "master",
      "short",
      "localized",
      "thumbnail",
      "audio",
      "subtitle",
      "project_file",
      "archive",
      "log",
      "checkpoint",
      "other"
     ],
     "title": "Kind",
     "type": "string"
    },
    "name": {
     "title": "Name",
     "type": "string"
    },
    "mime": {
     "title": "Mime",
     "type": "string"
    },
    "size": {
     "minimum": 0,
     "title": "Size",
     "type": "integer"
    },
    "sha256": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Sha256",
     "type": "string"
    },
    "project_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Project Id"
    },
    "produced_by_job": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Produced By Job"
    },
    "locations": {
     "items": {
      "$ref": "#/$defs/ArtifactLocation"
     },
     "title": "Locations",
     "type": "array"
    },
    "provenance": {
     "additionalProperties": true,
     "description": "licence, source URL, generator, model...",
     "title": "Provenance",
     "type": "object"
    },
    "retention": {
     "default": "keep",
     "enum": [
      "keep",
      "temporary",
      "archive"
     ],
     "title": "Retention",
     "type": "string"
    },
    "expires_at": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Expires At"
    },
    "created_at": {
     "title": "Created At",
     "type": "number"
    }
   },
   "required": [
    "kind",
    "name",
    "mime",
    "size",
    "sha256"
   ],
   "title": "ArtifactManifest",
   "type": "object"
  },
  "JobCheckpoint": {
   "additionalProperties": false,
   "properties": {
    "contract": {
     "const": "JobCheckpoint/v1",
     "default": "JobCheckpoint/v1",
     "title": "Contract",
     "type": "string"
    },
    "job_id": {
     "title": "Job Id",
     "type": "string"
    },
    "step": {
     "title": "Step",
     "type": "string"
    },
    "seq": {
     "minimum": 0,
     "title": "Seq",
     "type": "integer"
    },
    "state": {
     "additionalProperties": true,
     "title": "State",
     "type": "object"
    },
    "artifacts": {
     "description": "artifact ids produced so far",
     "items": {
      "type": "string"
     },
     "title": "Artifacts",
     "type": "array"
    },
    "created_at": {
     "title": "Created At",
     "type": "number"
    }
   },
   "required": [
    "job_id",
    "step",
    "seq"
   ],
   "title": "JobCheckpoint",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "contract": {
   "const": "WorkerExecutionResult/v1",
   "default": "WorkerExecutionResult/v1",
   "title": "Contract",
   "type": "string"
  },
  "job_id": {
   "title": "Job Id",
   "type": "string"
  },
  "provider": {
   "title": "Provider",
   "type": "string"
  },
  "connection_id": {
   "title": "Connection Id",
   "type": "string"
  },
  "status": {
   "enum": [
    "succeeded",
    "failed",
    "cancelled",
    "lost",
    "quota_exhausted"
   ],
   "title": "Status",
   "type": "string"
  },
  "started_at": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Started At"
  },
  "finished_at": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Finished At"
  },
  "duration_s": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Duration S"
  },
  "accelerator": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Accelerator"
  },
  "metrics": {
   "additionalProperties": true,
   "description": "gpu util, peak vram, cpu, sizes, download time...",
   "title": "Metrics",
   "type": "object"
  },
  "artifacts": {
   "items": {
    "$ref": "#/$defs/ArtifactManifest"
   },
   "title": "Artifacts",
   "type": "array"
  },
  "log_tail": {
   "default": "",
   "title": "Log Tail",
   "type": "string"
  },
  "error": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Error"
  },
  "checkpoint": {
   "anyOf": [
    {
     "$ref": "#/$defs/JobCheckpoint"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  }
 },
 "required": [
  "job_id",
  "provider",
  "connection_id",
  "status"
 ],
 "title": "WorkerExecutionResult",
 "type": "object"
}