# Copy to .env only if you need to change a default. Never commit .env.
# NEXUS_HOME=D:\NexusData            # where projects, models and the database live (default: .nexus next to the code)
# NEXUS_PORT=8765                    # local address is http://127.0.0.1:<port>
# NEXUS_BACKUP_PASSPHRASE=           # required before any backup leaves this computer. Keep a copy somewhere safe:
#                                    # without it an encrypted backup cannot be restored by anyone.
