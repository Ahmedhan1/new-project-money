    "end": 299.51,
    "action": "keep",
    "kind": "sentence",
    "reason": "kept: importance 93.0",
    "score": 74.4,
    "confidence": 0.7,
    "text": "Over 1 ,500 are specifically taken to ensure that the entire Martian surface will be mapped.",
    "speaker": "guest",
    "thought": "t26"
   },
   {
    "id": "sentence:source:314.98-321.22",
    "sentence_id": "sentence:source:314.98-321.22",
    "src": "/home/user/new-project-money/.nexus/benchmarks/documentary/source.mp4",
