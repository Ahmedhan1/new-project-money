+class GitBackend(StorageBackend):
+    """A dedicated branch of a private Git repository (e.g. the project's own GitHub repo) as an off-machine store
+    for SMALL, ENCRYPTED recovery data: database snapshot, timelines, reports. Never media or model weights.
+
+    Uses the user's existing Git credentials - no new account, no payment method. Writes are staged locally and
+    pushed as one commit by flush(); pushes are plain fast-forwards (never forced)."""
+    MAX_FILE = 50 * 1024 * 1024  # GitHub rejects files over 100 MB; stay far below
+
+    def __init__(self, url: str, branch: str = "nexus-backup", name: str = "git", workdir: str | Path | None = None):
+        self.url, self.branch, self.name = url, branch, name
+        self.dir = Path(workdir) if workdir else config.HOME / "run" / "gitstore" / hashlib.sha256(f"{url}#{branch}".encode()).hexdigest()[:12]
+        self._dirty = False
+        self._synced = False
+
+    def _git(self, *args: str, check: bool = True, timeout: int = 600) -> str:
+        r = subprocess.run(["git", "-C", str(self.dir), "-c", "user.name=NEXUS backup", "-c", "user.email=nexus-backup@localhost",
+                            "-c", "commit.gpgsign=false", "-c", "core.autocrlf=false", *args], capture_output=True, text=True, timeout=timeout)
+        if check and r.returncode != 0:
+            raise StorageError(f"{self.name}: git {args[0]} failed: {(r.stderr or r.stdout).strip()[-300:]}")
+        return r.stdout.strip()
+
+    def _sync(self) -> None:
+        if self._synced:
+            return
+        if not shutil.which("git"):
+            raise StorageError("git is not installed")
+        if not (self.dir / ".git").exists():
+            self.dir.mkdir(parents=True, exist_ok=True)
+            self._git("init", "-q")
+            self._git("remote", "add", "origin", self.url)
+        if self._git("ls-remote", "--heads", "origin", self.branch, timeout=120):
+            self._git("fetch", "-q", "origin", self.branch, timeout=1800)
+            self._git("checkout", "-q", "-B", self.branch, "FETCH_HEAD")
+        else:  # first use: an orphan branch that shares no history with the code
+            self._git("checkout", "-q", "--orphan", self.branch, check=False)
+        self._synced = True
+
+    def _p(self, key: str) -> Path:
+        p = (self.dir / key).resolve()
+        if self.dir.resolve() not in p.parents or ".git" in Path(key).parts:
+            raise StorageError(f"key escapes the storage root: {key}")
+        return p
+
+    def put(self, key: str, src: Path) -> None:
+        self._sync()
+        if Path(src).stat().st_size > self.MAX_FILE:
+            raise StorageError(f"{self.name}: {key} is {Path(src).stat().st_size / 1e6:.0f} MB - too large for a Git store (media belongs in object storage)")
+        dest = self._p(key)
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(src, dest)
+        self._dirty = True
+
+    def flush(self) -> None:
+        if not self._dirty:
+            return
+        self._git("add", "-A")
+        if self._git("status", "--porcelain"):
+            self._git("commit", "-q", "-m", "NEXUS backup")
+        self._git("push", "-q", "origin", f"HEAD:refs/heads/{self.branch}", timeout=1800)  # fast-forward only; a rejected push raises
+        self._dirty = False
+
+    def get(self, key: str, dest: Path) -> None:
+        self._sync()
+        src = self._p(key)
+        if not src.is_file():
+            raise StorageError(f"{self.name}: missing object {key}")
+        Path(dest).parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(src, dest)
+
+    def size(self, key: str) -> int | None:
+        self._sync()
+        p = self._p(key)
+        return p.stat().st_size if p.is_file() else None
+
+    def sha256(self, key: str) -> str:
+        """Checksum of what the REMOTE branch holds (re-fetched), not of the local working copy."""
+        self.flush()
+        self._git("fetch", "-q", "origin", self.branch, timeout=1800)
+        r = subprocess.run(["git", "-C", str(self.dir), "cat-file", "blob", f"FETCH_HEAD:{key}"], capture_output=True, timeout=600)
+        if r.returncode != 0:
+            raise StorageError(f"{self.name}: {key} is not on the remote branch")
+        return hashlib.sha256(r.stdout).hexdigest()
+
+    def list(self, prefix: str = "") -> list[dict]:
+        self._sync()
+        base = self.dir / prefix
+        if not base.exists():
+            return []
+        return [{"key": f.relative_to(self.dir).as_posix(), "size": f.stat().st_size}
+                for f in sorted(base.rglob("*")) if f.is_file() and ".git" not in f.relative_to(self.dir).parts]
+
+    def delete(self, key: str) -> None:
+        self._sync()
+        self._p(key).unlink(missing_ok=True)
+        self._dirty = True
+
+    def usage(self) -> dict:
+        self._sync()
+        # history keeps every old object, so the repository's packed size is what counts against the provider's limit
+        used = sum(f.stat().st_size for f in (self.dir / ".git").rglob("*") if f.is_file())
+        return {"used_bytes": used, "free_bytes": None}
+
