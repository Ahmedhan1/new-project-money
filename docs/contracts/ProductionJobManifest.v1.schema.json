   "type": "string"
  },
  "project_id": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Project Id"
  },
  "params": {
   "additionalProperties": true,
   "title": "Params",
   "type": "object"
  },
  "inputs": {
