new file mode 100644
index 0000000..9d6dcf3
--- /dev/null
+++ b/nexus/generate/image.py
@@ -0,0 +1,101 @@
+"""Local text-to-image on CPU (and GPU when present) with open-weight models whose licences allow commercial use.
+
+Candidates are the ones benchmarked on the build machine (scripts/bench_generation.py -> docs/results/gen_bench_image.json).
+The default is chosen by nexus.generate.select from registry/genmodels.yaml and the detected hardware."""
+from __future__ import annotations
+
+import hashlib
+import threading
+import time
+from pathlib import Path
+
+from .. import config, costguard, db
+
+# steps/guidance are the distilled (LCM) settings: 4-6 steps instead of 25-50.
+CANDIDATES: dict[str, dict] = {
+    "sd15-dreamshaper-lcm": {"repo": "Lykon/dreamshaper-8", "lora": "latent-consistency/lcm-lora-sdv1-5", "license": "CreativeML OpenRAIL-M + OpenRAIL++ (LCM-LoRA)",
+                             "steps": 5, "guidance": 1.5, "variant": "fp16", "cls": "sd", "bench_sizes": [(512, 288), (768, 432)]},
+    "ssd1b-lcm": {"repo": "segmind/SSD-1B", "lora": "latent-consistency/lcm-lora-ssd-1b", "license": "Apache-2.0 + OpenRAIL++ (LCM-LoRA)",
+                  "steps": 5, "guidance": 1.2, "variant": "fp16", "cls": "sdxl", "bench_sizes": [(1024, 576)]},
+}
+_lock = threading.Lock()
+_loaded: dict = {}
+
+
+def hf_cache() -> Path:
+    d = config.MODELS / "hf"
+    d.mkdir(parents=True, exist_ok=True)
+    return d
+
+
+def device() -> str:
+    import torch
+    return "cuda" if torch.cuda.is_available() else "cpu"
+
+
+def load(name: str):
+    """Build the pipeline (downloads weights on first use: free, public, no account)."""
+    costguard.authorize("diffusers-local", f"load {name}")
+    import torch
+    from diffusers import AutoPipelineForText2Image, LCMScheduler
+    spec = CANDIDATES[name]
+    dev = device()
+    kw = {"cache_dir": hf_cache(), "torch_dtype": torch.float16 if dev == "cuda" else torch.float32, "safety_checker": None}
+    if spec["variant"]:
+        kw["variant"] = spec["variant"]
+    if spec["cls"] == "sdxl":
+        kw.pop("safety_checker")
+    pipe = AutoPipelineForText2Image.from_pretrained(spec["repo"], **kw)
+    pipe.scheduler = LCMScheduler.from_config(pipe.scheduler.config)
+    pipe.load_lora_weights(spec["lora"], cache_dir=hf_cache())
+    pipe.fuse_lora()
+    pipe.to(dev)
+    pipe.set_progress_bar_config(disable=True)
+    if dev == "cpu":
+        torch.set_num_threads(max(1, torch.get_num_threads()))
+    return pipe
+
+
+def run(pipe, name: str, prompt: str, negative: str, width: int, height: int, seed: int = 0):
+    import torch
+    spec = CANDIDATES[name]
+    g = torch.Generator("cpu").manual_seed(seed)
+    with torch.inference_mode():
+        return pipe(prompt=prompt, negative_prompt=negative if spec["guidance"] > 1 else None, width=width, height=height,
+                    num_inference_steps=spec["steps"], guidance_scale=spec["guidance"], generator=g).images[0]
+
+
+def unload() -> None:
+    import gc
+    with _lock:
+        _loaded.clear()
+    gc.collect()
+
+
+NEGATIVE = "blurry, low quality, deformed, disfigured, extra limbs, extra fingers, text, caption, watermark, logo, frame"
+
+
+def generate(prompt: str, out: Path, *, name: str | None = None, width: int = 768, height: int = 432, seed: int = 0, negative: str = NEGATIVE) -> dict:
+    """Generate one image to `out`. Cached by (model, prompt, size, seed): asking again costs nothing.
+    Returns a provenance record that goes into the project's asset ledger."""
+    if name is None:
+        from . import select
+        name = select.choose("image")["model"]
+    key = hashlib.sha256(f"{name}|{prompt}|{negative}|{width}x{height}|{seed}".encode()).hexdigest()[:20]
+    cache = config.CACHE / "genimg" / f"{key}.jpg"
+    out = Path(out)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    t0 = time.time()
+    if not cache.exists():
+        with _lock:
+            if name not in _loaded:
+                _loaded.clear()
+                _loaded[name] = load(name)
+            img = run(_loaded[name], name, prompt, negative, width, height, seed)
+        cache.parent.mkdir(parents=True, exist_ok=True)
+        img.save(cache, quality=93)
+        db.metric("genimg_seconds", round(time.time() - t0, 2), model=name, size=f"{width}x{height}")
+    out.write_bytes(cache.read_bytes())
+    spec = CANDIDATES[name]
+    return {"path": str(out), "license": "generated by NEXUS (original output)", "source": f"local image model {name}", "model": spec["repo"],
+            "model_license": spec["license"], "prompt": prompt, "seed": seed, "seconds": round(time.time() - t0, 2), "cached": time.time() - t0 < 0.5}
diff --git a/nexus/generate/select.py b/nexus/generate/select.py
new file mode 100644
index 0000000..f41a240
--- /dev/null
+++ b/nexus/generate/select.py
@@ -0,0 +1,89 @@
+"""Model + compute selection: pick the strongest model that is (1) licensed for the user's use, (2) able to run on
+hardware that is actually available for free, and say plainly when nothing better can run.
+
+    choose("image") / choose("t2v") / choose("ti2v") / choose("i2v-camera")
+
+Order of preference: eligible licence -> fits a free compute tier -> higher quality -> already benchmarked here.
+A GPU model is only *recommended*, never claimed to work, until its adapter exists and it has been measured."""
+from __future__ import annotations
+
+import functools
+
+import yaml
+
+from .. import config
+
+KINDS = ("image", "t2v", "i2v", "ti2v", "i2v-camera")
+VIDEO_FOR = {"t2v": ("t2v", "ti2v"), "i2v": ("i2v", "ti2v"), "ti2v": ("ti2v",), "image": ("image",), "i2v-camera": ("i2v-camera",)}
+
+
+@functools.lru_cache(maxsize=1)
+def registry() -> dict:
+    return yaml.safe_load((config.REGISTRY_DIR / "genmodels.yaml").read_text(encoding="utf-8"))
+
+
+def hardware() -> dict:
+    from .. import compute
+    hw = compute.detect_hardware()
+    return {"ram_gb": hw["ram_gb"], "vram_gb": (hw["gpu"] or {}).get("vram_gb", 0), "threads": hw["threads"]}
+
+
+def license_ok(m: dict, settings: dict) -> tuple[bool, str]:
+    if m["commercial"] == "no":
+        return False, "non-commercial licence"
+    if m.get("territory_restricted") and not settings.get("accept_territory_restricted_models"):
+        return False, f"licence excludes some territories ({m['conditions']}) - opt in with \"accept_territory_restricted_models\" only if it applies to you"
+    if m["commercial"] == "conditional" and m["id"] not in settings.get("accepted_conditional_licenses", []):
+        return False, f"conditional licence - {m['conditions']} Add \"{m['id']}\" to \"accepted_conditional_licenses\" in settings.json after reading it"
+    return True, "ok"
+
+
+def fits(m: dict, tier: dict) -> bool:
+    if tier.get("vram_gb", 0) >= m.get("min_vram_gb", 1e9) and tier.get("ram_gb", 0) >= m.get("min_ram_gb", 0):
+        return True
+    return bool(m.get("cpu_ok")) and tier.get("ram_gb", 0) >= m.get("min_ram_gb", 0)
+
+
+def choose(kind: str, hw: dict | None = None, settings: dict | None = None) -> dict:
+    """Returns {model, where, runnable, reason, better_with: [...], rejected: [...]}."""
+    if kind not in KINDS:
+        raise ValueError(f"unknown generation kind {kind}")
+    settings = config.settings() if settings is None else settings
+    hw = hardware() if hw is None else hw
+    tiers = [{"id": "local", **hw}]
+    for c in registry()["compute"]:
+        if c["id"] != "local" and (settings.get("compute") or {}).get(c["id"]):
+            tiers.append({"id": c["id"], "vram_gb": c["vram_gb"], "ram_gb": c["ram_gb"]})
+    all_remote = [c for c in registry()["compute"] if c["id"] != "local"]
+    cands = [m for m in registry()["models"] if m["kind"] in VIDEO_FOR[kind]]
+    rejected, ok = [], []
+    for m in cands:
+        good, why = license_ok(m, settings)
+        (ok if good else rejected).append(m if good else {"id": m["id"], "why": why})
+    ranked = sorted(ok, key=lambda m: (-m["quality"], not m.get("benchmarked"), m["id"]))
+    pick = None
+    for m in ranked:
+        for t in tiers:  # local first: never send work away that this machine can do
+            # a model is runnable only where NEXUS has a working adapter for it: today that is the local diffusers path
+            # ... and only a model measured on real hardware may become a default (benchmarked: true)
+            if fits(m, t) and m.get("local") and m.get("benchmarked") and t["id"] == "local":
+                pick = {"model": m["id"], "where": "local-gpu" if t.get("vram_gb", 0) >= m.get("min_vram_gb", 1e9) else "local-cpu", "runnable": True,
+                        "quality": m["quality"], "license": m["license"], "reason": m["notes"]}
+                break
+        if pick:
+            break
+    better = []
+    for m in ranked:
+        if pick and m["quality"] <= pick["quality"]:
+            continue
+        where = [t["id"] for t in tiers if fits(m, t)] or [c["id"] + " (not authorised)" for c in all_remote if fits(m, c)]
+        better.append({"model": m["id"], "quality": m["quality"], "needs": f"{m.get('min_vram_gb', '?')} GB VRAM", "could_run_on": where or ["no free tier - too large"],
+                       "blocked_by": "no GPU adapter implemented yet (task GEN-2)" if not m.get("local") else "hardware"})
+    if pick is None:
+        pick = {"model": None, "where": None, "runnable": False, "quality": 0,
+                "reason": "no eligible model fits the available free hardware"}
+    return {"kind": kind, **pick, "better_with": better, "rejected": rejected, "hardware": hw, "tiers": [t["id"] for t in tiers]}
+
+
+def report(hw: dict | None = None) -> list[dict]:
+    return [choose(k, hw) for k in ("image", "t2v", "ti2v", "i2v-camera")]
