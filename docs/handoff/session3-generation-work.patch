+# Generative model registry for the NEXUS model + compute selector (nexus/generate/select.py).
+# Licences were read from each model's Hugging Face card on 2026-11-12 (the `license` field of the card).
+# VRAM figures for GPU models are REPORTED by upstream/community sources and were NOT measured here (no GPU on the
+# build machine); `benchmarked: true` means scripts/bench_generation.py ran it on the build machine.
+# commercial: yes | conditional (allowed under stated conditions) | no (never selected)
+# quality: 1-5, relative rank inside its kind, from public reports - used only to order eligible candidates.
+checked: "2026-11-12"
+models:
+  # ------------------------------------------------------------------ image
+  - id: sd15-dreamshaper-lcm
+    kind: image
+    repo: Lykon/dreamshaper-8 + latent-consistency/lcm-lora-sdv1-5
+    license: CreativeML OpenRAIL-M + OpenRAIL++
+    commercial: "yes"
+    params_b: 1.0
+    cpu_ok: true
+    min_ram_gb: 6
+    min_vram_gb: 4
+    native: 512-768 px
+    quality: 2
+    benchmarked: true
+    local: true
+    notes: 5-step LCM. The only class that is practical on 4 CPU threads. Weak hands/faces at small sizes; no legible text.
+  - id: tiny-sd-lcm
+    kind: image
+    repo: segmind/tiny-sd + latent-consistency/lcm-lora-sdv1-5
+    license: CreativeML OpenRAIL-M + OpenRAIL++
+    commercial: "yes"
+    params_b: 0.5
+    cpu_ok: true
+    min_ram_gb: 4
+    min_vram_gb: 2
+    native: 512 px
+    quality: 1
+    benchmarked: false
+    local: false
+    notes: REJECTED after testing - its pruned UNet cannot load the LCM-LoRA (shape mismatch), so it would need 25+ steps and lose its speed advantage.
+  - id: ssd1b-lcm
+    kind: image
+    repo: segmind/SSD-1B + latent-consistency/lcm-lora-ssd-1b
+    license: Apache-2.0 + OpenRAIL++
+    commercial: "yes"
+    params_b: 1.3
+    cpu_ok: true
+    min_ram_gb: 12
+    min_vram_gb: 6
+    native: 1024 px
+    quality: 3
+    benchmarked: false
+    local: true
+    notes: Distilled SDXL. 1024 px native; several times slower than SD1.5 on CPU.
+  - id: z-image-turbo
+    kind: image
+    repo: Tongyi-MAI/Z-Image-Turbo
+    license: Apache-2.0
+    commercial: "yes"
+    params_b: 6
+    cpu_ok: false
+    min_vram_gb: 8
+    native: 1024 px
+    quality: 4
+    benchmarked: false
+    local: false
+    notes: Few-step, reported to run on 8 GB VRAM. Needs a GPU adapter (not implemented).
+  - id: flux2-klein-4b
+    kind: image
+    repo: black-forest-labs/FLUX.2-klein-4B
+    license: Apache-2.0
+    commercial: "yes"
+    params_b: 4
+    cpu_ok: false
+    min_vram_gb: 12
+    native: 1024 px
+    quality: 5
+    benchmarked: false
+    local: false
+    notes: Supports reference-image editing (useful for character consistency). GPU adapter not implemented.
+  - id: qwen-image
+    kind: image
+    repo: Qwen/Qwen-Image
+    license: Apache-2.0
+    commercial: "yes"
+    params_b: 20
+    cpu_ok: false
+    min_vram_gb: 16
+    native: 1328 px
+    quality: 5
+    benchmarked: false
+    local: false
+    notes: Best in-image text. Too large for the free 16 GB T4 without heavy quantisation.
+  - id: sdxl-turbo
+    kind: image
+    repo: stabilityai/sdxl-turbo
+    license: Stability AI Non-Commercial Community (sai-nc-community)
+    commercial: "no"
+    params_b: 2.6
+    cpu_ok: true
+    min_ram_gb: 12
+    quality: 3
+    benchmarked: false
+    local: false
+    notes: REJECTED - non-commercial licence. Listed so nobody re-evaluates it by mistake.
+  # ------------------------------------------------------------------ video
+  - id: animatediff-lightning-4step
+    kind: t2v
+    repo: ByteDance/AnimateDiff-Lightning (base Lykon/dreamshaper-8)
+    license: CreativeML OpenRAIL-M
+    commercial: "yes"
+    params_b: 1.5
+    cpu_ok: true
+    min_ram_gb: 8
+    min_vram_gb: 6
+    native: 512x288, 16 frames @ 8 fps (2 s)
+    quality: 1
+    benchmarked: true
+    local: true
+    notes: The only text-to-video that runs on this CPU in minutes. Short, soft, loop-like motion. A stop-gap, not cinematic.
+  - id: depth-parallax
+    kind: i2v-camera
+    repo: depth-anything/Depth-Anything-V2-Small-hf
+    license: Apache-2.0
+    commercial: "yes"
+    params_b: 0.025
+    cpu_ok: true
+    min_ram_gb: 2
+    native: any (rendered at timeline size)
+    quality: 2
+    benchmarked: true
+    local: true
+    notes: 2.5D camera move from one still (push-in, pan, orbit). Camera motion only - subjects do not move.
+  - id: wan21-t2v-1.3b
+    kind: t2v
+    repo: Wan-AI/Wan2.1-T2V-1.3B-Diffusers
+    license: Apache-2.0
+    commercial: "yes"
+    params_b: 1.3
+    cpu_ok: false
+    min_vram_gb: 8
+    min_ram_gb: 16
+    native: 832x480, 81 frames @ 16 fps (5 s)
+    quality: 3
+    benchmarked: false
+    local: false
+    notes: Smallest serious T2V. ~8.2 GB VRAM reported. Its UMT5-XXL text encoder (~5.7 B parameters) alone exceeds what a 16 GB CPU machine can run usefully.
+  - id: wan22-ti2v-5b
+    kind: ti2v
+    repo: Wan-AI/Wan2.2-TI2V-5B-Diffusers
+    license: Apache-2.0
+    commercial: "yes"
+    params_b: 5
