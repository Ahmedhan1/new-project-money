{
 "youtube": {
  "platform": "youtube",
  "display": "YouTube (long-form video)",
  "media": {
   "aspect_recommended": {
    "value": "16:9",
    "kind": "documented",
    "source": "https://support.google.com/youtube/answer/6375112",
    "read_on": "2026-11-12",
    "note": "do not add padding or black bars to the video; the player pads non-16:9 itself"
   },
   "resolution_recommended": {
    "value": {
     "width": 1920,
     "height": 1080
    },
    "kind": "documented",
    "source": "https://support.google.com/youtube/answer/6375112",
    "read_on": "2026-11-12",
    "note": "1080p is one of the listed 16:9 resolutions (240p to 4320p); NEXUS renders 1080p"
   },
   "resolution_max": {
    "value": {
     "width": 7680,
     "height": 4320
    },
    "kind": "documented",
    "source": "https://support.google.com/youtube/answer/6375112",
    "read_on": "2026-11-12"
   },
   "fps": {
    "value": {
     "list": [
      24,
      25,
      30,
      48,
      50,
      60
     ]
    },
    "kind": "documented",
    "source": "https://support.google.com/youtube/answer/1722171",
    "read_on": "2026-11-12",
    "note": "upload at the frame rate it was recorded; deinterlace interlaced material"
   },
   "duration_max_s": {
    "value": 43200,
    "kind": "documented",
    "source": "https://support.google.com/youtube/answer/71673",
    "read_on": "2026-11-12",
    "note": "256 GB or 12 hours, whichever is less"
   },
   "max_file_bytes": {
    "value": 256000000000,
    "kind": "documented",
    "source": "https://support.google.com/youtube/answer/71673",
    "read_on": "2026-11-12"
   },
   "title_max_chars": {
    "value": 100,
    "kind": "documented",
    "source": "https://developers.google.com/youtube/v3/docs/videos",
    "read_on": "2026-11-12",
    "note": "may not contain < or >"
   },
   "description_max_bytes": {
    "value": 5000,
    "kind": "documented",
    "source": "https://developers.google.com/youtube/v3/docs/videos",
    "read_on": "2026-11-12",
    "note": "5000 BYTES of UTF-8, not characters; may not contain < or >"
   },
   "tags_max_chars": {
    "value": 500,
    "kind": "documented",
    "source": "https://developers.google.com/youtube/v3/docs/videos",
    "read_on": "2026-11-12",
    "note": "whole tag list; commas count; tags with spaces count their quotes"
   },
   "hashtags_max": {
    "value": 60,
    "kind": "documented",
    "source": "https://support.google.com/youtube/answer/6390658",
    "read_on": "2026-11-12",
    "note": "with more than 60 hashtags ALL are ignored; up to 3 are shown near the title"
   },
   "thumbnail": {
    "value": {
     "width": 3840,
     "height": 2160,
     "min_width": 640,
     "aspect": "16:9",
     "formats": [
      "jpg",
      "png"
     ],
     "max_bytes": 2000000,
     "max_bytes_desktop": 50000000,
     "needs_verified_account": true
    },
    "kind": "documented",
    "source": "https://support.google.com/youtube/answer/72431",
    "read_on": "2026-11-12",
    "note": "2 MB limit applies on mobile, 50 MB on desktop; NEXUS writes a 1920x1080 JPEG under 2 MB"
   },
   "caption_files": {
    "value": [
     "srt",
     "vtt",
     "sbv",
     "ttml",
     "dfxp",
     "sami",
     "rt",
     "mpsub",
     "lrc",
     "cap"
    ],
    "kind": "documented",
    "source": "https://support.google.com/youtube/answer/2734698",
    "read_on": "2026-11-12",
    "note": "SRT and SBV must be plain UTF-8; WebVTT supports positioning"
   },
   "safe_zone": {
    "value": null,
    "kind": "unverified",
    "note": "no official overlay zones for long-form; player controls auto-hide"
   },
   "music_policy": {
    "value": "Use music you own or have licensed. Tracks from the YouTube Audio Library do not receive Content ID claims.",
    "kind": "documented",
    "source": "https://support.google.com/youtube/answer/15424877",
    "read_on": "2026-11-12"
   }
  },
  "api": {
   "upload": {
    "endpoint": {
     "value": "POST https://www.googleapis.com/upload/youtube/v3/videos?uploadType=resumable&part=snippet,status",
     "kind": "documented",
     "source": "https://developers.google.com/youtube/v3/guides/using_resumable_upload_protocol",
     "verified": "2026-11-12"
    },
    "protocol": {
     "value": "initiate (X-Upload-Content-Length/-Type) -> 200 + Location session URI -> PUT bytes -> 201; on interruption PUT 'Content-Range: bytes */TOTAL' -> 308 + Range; retry 500/502/503/504 with exponential backoff (honour Retry-After); 404 = session expired, restart",
     "kind": "documented",
     "source": "https://developers.google.com/youtube/v3/guides/using_resumable_upload_protocol",
     "verified": "2026-11-12"
    },
    "scopes": {
     "value": [
      "https://www.googleapis.com/auth/youtube.upload"
     ],
     "kind": "documented",
     "source": "https://developers.google.com/youtube/v3/docs/videos/insert",
     "verified": "2026-11-12",
     "note": "any of youtube.upload, youtube, youtubepartner, youtube.force-ssl authorises videos.insert; NEXUS asks for the narrowest"
    },
    "max_file_bytes": {
     "value": 256000000000,
     "kind": "documented",
     "source": "https://developers.google.com/youtube/v3/docs/videos/insert",
     "verified": "2026-11-12"
    },
    "mime": {
     "value": [
      "video/*",
      "application/octet-stream"
     ],
     "kind": "documented",
     "source": "https://developers.google.com/youtube/v3/docs/videos/insert",
     "verified": "2026-11-12"
    },
    "unverified_app_visibility": {
     "value": "not restricted",
     "kind": "documented",
     "source": "https://developers.google.com/youtube/v3/docs/videos/insert",
     "verified": "2026-11-12",
     "note": "the page reads 'Videos uploaded from unverified API projects are not restricted to private viewing mode.' NEXUS still uploads privacyStatus=private unless the owner approved public"
    },
    "app_review": {
     "value": "none required for the owner's own Google Cloud project; more quota via the quota extension form",
     "kind": "documented",
     "source": "https://developers.google.com/youtube/v3/determine_quota_cost",
     "verified": "2026-11-12"
    },
    "thumbnail": {
     "value": "thumbnails.set (custom thumbnails need a verified channel, platforms.yaml yt_thumbnails)",
     "kind": "documented",
     "source": "https://developers.google.com/youtube/v3/determine_quota_cost",
     "verified": "2026-11-12"
    }
   },
   "quota": {
    "value": {
     "daily_units": 10000,
     "videos_insert": "1 unit per call in a separate 'Video Uploads' bucket limited to 100 calls/day",
     "thumbnails_set": 50,
     "videos_list": 1
    },
    "kind": "documented",
    "source": "https://developers.google.com/youtube/v3/determine_quota_cost",
    "verified": "2026-11-12",
    "note": "the older figure '1600 units per videos.insert' is NOT what the current pages state; both the quota-cost page and videos.insert page say 100 uploads/day at 1 unit each in their own bucket"
   },
   "oauth": {
    "value": {
     "flow": "installed app, loopback redirect http://127.0.0.1:<port>, PKCE S256",
     "auth_endpoint": "https://accounts.google.com/o/oauth2/v2/auth",
     "token_endpoint": "https://oauth2.googleapis.com/token",
     "oob": "no longer supported"
    },
    "kind": "documented",
    "source": "https://developers.google.com/identity/protocols/oauth2/native-app",
    "verified": "2026-11-12"
   },
   "analytics": {
    "value": {
     "endpoint": "GET https://youtubeanalytics.googleapis.com/v2/reports",
     "required": [
      "ids",
      "startDate",
      "endDate",
      "metrics"
     ],
     "scopes": [
      "https://www.googleapis.com/auth/yt-analytics.readonly",
      "https://www.googleapis.com/auth/youtube.readonly"
     ],
     "metrics": [
      "views",
      "estimatedMinutesWatched",
      "averageViewDuration",
      "averageViewPercentage",
      "audienceWatchRatio",
      "relativeRetentionPerformance",
      "subscribersGained",
      "subscribersLost",
      "likes",
      "comments",
      "shares"
     ],
     "retention": "dimensions=elapsedVideoTimeRatio, one video per request",
     "impressions_ctr": "not on the metrics page read - import from the YouTube Studio export"
    },
    "kind": "documented",
    "source": "https://developers.google.com/youtube/analytics/metrics",
    "verified": "2026-11-12",
    "note": "reports.query page (yt_reports) says requests now require youtube.readonly; averageViewDuration excludes looping clips since 2021-12-13"
   }
  },
  "adapter": "youtube",
  "adapter_status": "implemented_untested_live",
  "default_visibility": "private",
  "media_reviewed_on": "2026-11-12",
  "api_verified_on": "2026-11-12"
