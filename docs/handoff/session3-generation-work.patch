+def test_stock_photo_must_be_about_the_scene(home, monkeypatch):
+    assert assets.relevance("Human hip implant components", "Human immune system cells") < 0.5
+    assert assets.relevance("Vaccination at an immunization clinic", "vaccine clinic") >= 0.5
+    assert assets.relevance("Solar panels on a roof", "solar panel roof") == 1.0
+
+    def commons(q, n=5, min_width=1000):
+        return [{"id": "commons:9", "title": "Human hip implant components"}]
+
+    commons.__name__ = "search_commons"
+    monkeypatch.setattr(assets, "search_commons", commons)
+    monkeypatch.setattr(assets, "search_images", lambda q, **k: [])
+    monkeypatch.setattr(assets, "acquire", lambda c: {"id": c["id"], "path": "x.jpg", "license": "CC0"})
+    monkeypatch.setattr(assets, "_usable_image", lambda p: True)
+    assert assets.find_image("Human immune system cells", min_relevance=0.5) is None      # rejected -> the scene gets a generated picture
+    assert assets.find_image("Human immune system cells")["relevance"] < 0.5              # old behaviour still available, and labelled
diff --git a/tests/fast/test_storage_backup.py b/tests/fast/test_storage_backup.py
index d17405e..0be8952 100644
--- a/tests/fast/test_storage_backup.py
+++ b/tests/fast/test_storage_backup.py
@@ -204,3 +204,73 @@ def test_prune_keeps_recent_snapshots_restorable(home, tmp_path):
     out = backup.prune(b, keep=1)
     assert out["snapshots_removed"] == 2 and len(backup.list_snapshots(b)) == 1
     assert backup.verify(b)["ok"] and backup.restore(b, tmp_path / "after-prune")["ok"]
+
+
+def _bare(tmp_path):
+    import subprocess
+    remote = tmp_path / "offsite.git"
+    subprocess.run(["git", "init", "-q", "--bare", str(remote)], check=True)
+    return remote
+
+
+def test_git_branch_backend_contract_and_remote_checksum(tmp_path, home):
+    remote = _bare(tmp_path)
+    b = storage.GitBackend(str(remote), "nexus-backup", workdir=tmp_path / "wc")
+    f = tmp_path / "a.bin"
+    f.write_bytes(os.urandom(30_000))
+    assert b.size("x/a.bin") is None and b.list("x") == []
+    b.put("x/a.bin", f)
+    b.flush()
+    assert b.size("x/a.bin") == 30_000 and b.sha256("x/a.bin") == storage.sha256_file(f)      # hashed from the REMOTE branch
+    # a second machine sees the object after cloning the branch
+    other = storage.GitBackend(str(remote), "nexus-backup", workdir=tmp_path / "wc2")
+    other.get("x/a.bin", tmp_path / "back.bin")
+    assert (tmp_path / "back.bin").read_bytes() == f.read_bytes() and [o["key"] for o in other.list()] == ["x/a.bin"]
+    big = tmp_path / "big.bin"
+    with open(big, "wb") as fh:
+        fh.truncate(storage.GitBackend.MAX_FILE + 1)
+    with pytest.raises(storage.StorageError, match="too large"):                               # media never goes into Git
+        b.put("x/big.bin", big)
+    with pytest.raises(storage.StorageError):
+        b.put("../escape", f)
+    b.delete("x/a.bin")
+    b.flush()
+    assert storage.GitBackend(str(remote), "nexus-backup", workdir=tmp_path / "wc3").size("x/a.bin") is None
+
+
+def test_offsite_git_backup_restores_on_a_fresh_machine(home, tmp_path, monkeypatch):
+    """External backup strategy: encrypted state + metadata pushed to a Git branch; the laptop dies; restore from the remote alone."""
+    p, m = _project(home, tmp_path)
+    remote = _bare(tmp_path)
+    dest = {"name": "offsite", "provider": "git-private-branch", "url": str(remote), "enabled": True}
+    storage.save_destinations([dest])
+    out = backup.run_backup()
+    assert not out["ok"] and "authorized" in out["results"][0]["error"]                        # needs the user's explicit consent
+    storage.save_destinations([{**dest, "authorized": True}])
+    assert "NEXUS_BACKUP_PASSPHRASE" in backup.run_backup()["results"][0]["error"]             # and never leaves the machine unencrypted
+    monkeypatch.setenv("NEXUS_BACKUP_PASSPHRASE", "correct horse battery staple")
+    out = backup.run_backup()
+    r = out["results"][0]
+    assert out["ok"] and r["encrypted"] and r["verify"]["ok"] and r["verify"]["checksums_compared"] > 0
+    import subprocess
+    tree = subprocess.run(["git", "-C", str(remote), "ls-tree", "-r", "--name-only", "nexus-backup"], capture_output=True, text=True).stdout
+    assert "repo.json" in tree and "snapshots/" in tree and "blobs/" in tree
+    raw = subprocess.run(["git", "-C", str(remote), "grep", "-c", "-e", "Holiday film", "nexus-backup"], capture_output=True, text=True).stdout
+    assert raw == ""                                                                           # nothing readable on the remote
+    snap = backup.load_snapshot(storage.open_destination(storage.destinations()[0]), r["snapshot"], backup._key("correct horse battery staple",
+                                __import__("base64").b64decode(json.loads(subprocess.run(["git", "-C", str(remote), "show", "nexus-backup:repo.json"],
+                                                                                           capture_output=True, text=True).stdout)["salt"])))
+    assert {f["tier"] for f in snap["files"]} == {"state", "metadata"}                         # originals/media are NOT pushed to Git
+    # the machine is lost: only the remote and the passphrase survive
+    db.reset_for_tests()
+    home.rename(tmp_path / "dead-laptop")
+    new_home = tmp_path / "new-laptop" / ".nexus"
+    config.set_home(new_home)
+    config.ensure_dirs()
+    storage.save_destinations([{**dest, "authorized": True}])
+    res = backup.restore(storage.open_destination(storage.destinations()[0]), tmp_path / "restored", pw="correct horse battery staple")
+    assert res["files_restored"] == res["files_expected"] > 0 and not res["problems"]
+    config.set_home(tmp_path / "restored")
+    q = prj.Project(p.id)
+    assert q.name == "Holiday film" and q.timeline()["clips"][0]["type"] == "video"            # project, history and timeline are back
+    assert res["references"]["missing"] and all("media" in x or "audio" in x for x in res["references"]["missing"])   # media must come from a media-capable destination: reported, not hidden
diff --git a/.github/workflows/windows-launchers.yml b/.github/workflows/windows-launchers.yml
new file mode 100644
index 0000000..daba608
--- /dev/null
+++ b/.github/workflows/windows-launchers.yml
@@ -0,0 +1,70 @@
+name: Windows launchers
+# Runs the real NEXUS_*.bat files on a real Windows machine: full setup (without the 7 GB of models), one-click start,
+# health check, status, backup + restore drill, stop. Heavier than CI, so it only runs when the launchers, the setup
+# script or the dependency lists change - or on demand.
+on:
+  workflow_dispatch:
+  pull_request:
+    paths: ["NEXUS_*.bat", "scripts/windows/**", "requirements.txt", "requirements-gen.txt", "nexus/launcher.py", ".github/workflows/windows-launchers.yml"]
+concurrency:
+  group: winlaunch-${{ github.ref }}
+  cancel-in-progress: true
+permissions:
+  contents: read
+jobs:
+  double-click:
+    runs-on: windows-latest
+    timeout-minutes: 40
+    env:
+      NEXUS_NO_PAUSE: "1"
+      PYTHONUTF8: "1"
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: FFmpeg (the setup script would install it with winget on a normal PC)
+        run: choco install ffmpeg -y --no-progress
+      - name: NEXUS_SETUP.bat (no models)
+        shell: cmd
+        run: NEXUS_SETUP.bat -SkipModels
+      - name: Setup log
+        if: always()
+        shell: cmd
+        run: if exist setup.log type setup.log
+      - name: NEXUS_START.bat
+        shell: cmd
+        run: NEXUS_START.bat --no-browser
+      - name: App answers on http://127.0.0.1:8765
+        shell: pwsh
+        run: |
+          $h = Invoke-RestMethod http://127.0.0.1:8765/api/health
+          $h | ConvertTo-Json
+          if (-not $h.ok) { exit 1 }
+          (Invoke-WebRequest http://127.0.0.1:8765/).Content.Substring(0, 200)
+      - name: A real job through the worker (motion-graphics render)
+        shell: pwsh
+        run: |
+          Invoke-RestMethod -Method Post -Uri http://127.0.0.1:8765/api/animate -ContentType application/json -Body '{"kind":"kinetic","title":"t","data":["Windows","works"]}'
+          foreach ($i in 1..60) { $j = (Invoke-RestMethod http://127.0.0.1:8765/api/jobs)[0]; if ($j.status -in "done","failed") { break }; Start-Sleep 2 }
+          $j | ConvertTo-Json -Depth 5
+          if ($j.status -ne "done") { exit 1 }
+      - name: NEXUS_STATUS.bat
+        shell: cmd
+        run: NEXUS_STATUS.bat
+      - name: NEXUS_BACKUP.bat (backup + restore drill)
+        shell: cmd
+        run: NEXUS_BACKUP.bat
+      - name: NEXUS_DOCTOR.bat (informational - optional tools such as Blender are not installed on the runner)
+        shell: cmd
+        continue-on-error: true
+        run: NEXUS_DOCTOR.bat
+      - name: NEXUS_STOP.bat
+        shell: cmd
+        run: NEXUS_STOP.bat
+      - name: Logs
+        if: always()
+        shell: cmd
+        run: |
+          if exist .nexus\logs\api.log type .nexus\logs\api.log
+          if exist .nexus\logs\worker.log type .nexus\logs\worker.log
