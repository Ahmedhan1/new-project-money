new file mode 100644
index 0000000..6c3b7d8
--- /dev/null
+++ b/tests/fast/test_bench.py
@@ -0,0 +1,80 @@
+"""Quality regression machinery: the measurements separate a slideshow from moving pictures, and the comparison
+fails only when a ruled metric really gets worse."""
+import shutil
+import subprocess
+
+import pytest
+
+from nexus import bench
+
+ff = pytest.mark.skipif(not shutil.which("ffmpeg"), reason="ffmpeg not installed")
+
+
+def _video(path, source):
+    subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-f", "lavfi", "-i", source, "-t", "4", "-pix_fmt", "yuv420p", str(path)], check=True)
+    return path
+
+
+@ff
+def test_picture_metrics_tell_a_still_from_motion(tmp_path):
+    still = bench.picture_metrics(_video(tmp_path / "still.mp4", "color=c=0x224466:s=320x180:r=30"))
+    moving = bench.picture_metrics(_video(tmp_path / "moving.mp4", "testsrc2=s=320x180:r=30"))
+    assert still["frozen_ratio"] == 1.0 and still["mean_change"] < 0.05 and still["sharpness"] < 1
+    assert moving["frozen_ratio"] < 0.2 and moving["mean_change"] > 1 and moving["sharpness"] > still["sharpness"] + 50
+    assert moving["colorfulness"] > still["colorfulness"]
+
+
+def test_timeline_and_subtitle_metrics():
+    tl = {"clips": [
+        {"type": "color", "duration": 2.4},
+        {"type": "video", "in": 0, "out": 10, "narration": "a", "shots": [{"kind": "generated-video", "image": None}, {"kind": "generated", "image": "a.jpg"}, {"kind": "generated", "image": "b.jpg"}]},
+        {"type": "image", "src": "c.jpg", "duration": 6, "narration": "b", "provenance": {"source": "wikimedia-commons"}},
+        {"type": "image", "src": "card.jpg", "duration": 6, "narration": "c", "provenance": {"source": "title-card generator"}}],
+        "subtitles": [{"start": 0, "end": 2, "text": "It ends here. And a new"}, {"start": 2, "end": 4, "text": "sentence continues cleanly."}]}
+    t = bench.timeline_metrics(tl)
+    assert t["scenes"] == 3 and t["real_picture_ratio"] == round(2 / 3, 3) and t["generated_motion_shots"] == 1 and t["shots_per_scene"] == round(5 / 3, 2)
+    s = bench.subtitle_metrics(tl)
+    assert s["cues"] == 2 and s["straddling_cues"] == 1 and s["max_chars"] == 27
+
+
+def test_story_metrics_use_the_qa_report():
+    script = {"scenes": [{"narration": "Did you know panels make power? They use light."}, {"narration": "Batteries store it. Costs fall."}]}
+    rep = {"stages": [{"stage": "1-pre-production", "checks": [{"ok": True}, {"ok": True}, {"ok": False}, {"ok": True}]}]}
+    m = bench.story_metrics(script, rep)
+    assert m == {"scenes": 2, "words": 14, "min_words_per_scene": 5, "sentences_per_scene": 2.0, "hook": 1, "gates_passed_ratio": 0.75}
+
+
+def _m(**over):
+    base = {"visual": {"sharpness": 100.0, "real_picture_ratio": 1.0}, "motion": {"mean_change": 2.0, "frozen_ratio": 0.1, "generated_motion_shots": 1},
+            "audio": {"lufs": -14.2, "true_peak": -1.5}, "voice": {"heard_back": 0.9}, "subtitles": {"straddling_cues": 0},
+            "technical": {"decode_errors": 0, "width": 1280, "height": 720, "fps": 30.0, "qa_passed": 1}}
+    for k, v in over.items():
+        g, key = k.split("__")
+        base[g][key] = v
+    return base
+
+
+def test_compare_flags_real_regressions_only():
+    base = {"cases": {"x": _m()}}
+    same = bench.compare({"cases": {"x": _m(visual__sharpness=92.0, audio__lufs=-13.6, voice__heard_back=0.86)}}, base)
+    assert same["ok"] and same["cases"]["x"]["regressions"] == []                       # normal run-to-run variation passes
+    worse = bench.compare({"cases": {"x": _m(motion__frozen_ratio=0.8, motion__generated_motion_shots=0, visual__real_picture_ratio=0.5,
+                                             audio__lufs=-19.0, technical__width=640, subtitles__straddling_cues=2, technical__qa_passed=0)}}, base)
+    bad = {r["metric"] for r in worse["cases"]["x"]["regressions"]}
+    assert not worse["ok"] and bad == {"motion.frozen_ratio", "motion.generated_motion_shots", "visual.real_picture_ratio", "audio.lufs",
+                                       "technical.width", "subtitles.straddling_cues", "technical.qa_passed"}
+    better = bench.compare({"cases": {"x": _m(visual__sharpness=160.0, motion__frozen_ratio=0.0)}}, base)
+    assert better["ok"] and {r["metric"] for r in better["cases"]["x"]["improvements"]} == {"visual.sharpness", "motion.frozen_ratio"}
+    assert bench.compare({"cases": {"new-case": _m()}}, base)["cases"]["new-case"]["status"].startswith("new")
+
+
+def test_accept_keeps_history(tmp_path, monkeypatch):
+    import json
+    monkeypatch.setattr(bench, "RESULTS", tmp_path)
+    monkeypatch.setattr(bench, "BASELINE", tmp_path / "baseline.json")
+    (tmp_path / "current.json").write_text(json.dumps({"date": "d1", "cases": {"x": _m()}}))
+    bench.accept("first")
+    (tmp_path / "current.json").write_text(json.dumps({"date": "d2", "cases": {"x": _m(visual__sharpness=150.0)}}))
+    cur = bench.accept("better visuals")
+    assert cur["note"] == "better visuals" and json.loads((tmp_path / "baseline.json").read_text())["date"] == "d2"
+    assert [h["date"] for h in json.loads((tmp_path / "history.json").read_text())] == ["d1"]
diff --git a/tests/fast/test_generate_select.py b/tests/fast/test_generate_select.py
new file mode 100644
index 0000000..50d9b4e
--- /dev/null
+++ b/tests/fast/test_generate_select.py
@@ -0,0 +1,50 @@
+"""Model + compute selection: licence first, then what can really run for free, and honest about what cannot."""
+from nexus.generate import select
+
+CPU = {"ram_gb": 15.6, "vram_gb": 0, "threads": 4}
+GPU8 = {"ram_gb": 32, "vram_gb": 8, "threads": 8}
+
+
+def test_registry_declares_licence_and_requirements_for_every_model():
+    ids = set()
+    for m in select.registry()["models"]:
+        assert {"id", "kind", "repo", "license", "commercial", "quality", "benchmarked", "local", "notes"} <= set(m), m["id"]
+        assert m["commercial"] in ("yes", "conditional", "no") and m["kind"] in select.KINDS
+        assert m["commercial"] != "conditional" or m.get("conditions"), m["id"]
+        assert m.get("cpu_ok") or m.get("min_vram_gb"), m["id"]
+        assert m["id"] not in ids
+        ids.add(m["id"])
+    for needed in ("wan21-t2v-1.3b", "wan22-ti2v-5b", "ltx-2", "hunyuanvideo-1.5", "cogvideox-2b"):   # the models the brief asked to evaluate
+        assert needed in ids
+
+
+def test_cpu_only_machine_gets_models_that_actually_run_and_is_told_what_is_better():
+    img = select.choose("image", CPU, {})
+    assert img["runnable"] and img["where"] == "local-cpu" and img["model"] == "sd15-dreamshaper-lcm"   # ssd1b needs 12 GB + is unbenchmarked... but higher quality
+    vid = select.choose("t2v", CPU, {})
+    assert vid["runnable"] and vid["model"] == "animatediff-lightning-4step" and vid["where"] == "local-cpu"
+    better = {b["model"]: b for b in vid["better_with"]}
+    assert "wan21-t2v-1.3b" in better and better["wan21-t2v-1.3b"]["could_run_on"] == ["kaggle (not authorised)"]
+    assert "GEN-2" in better["wan22-ti2v-5b"]["blocked_by"]                      # recommended, never claimed to work
+    assert select.choose("i2v-camera", CPU, {})["model"] == "depth-parallax"
+    assert select.choose("ti2v", CPU, {})["runnable"] is False                   # no image-to-video model fits a CPU: said plainly
+
+
+def test_licence_gates():
+    r = select.choose("t2v", CPU, {})
+    rejected = {x["id"]: x["why"] for x in r["rejected"]}
+    assert "territories" in rejected["hunyuanvideo-1.5"] and "conditional" in rejected["ltx-2"] and "conditional" in rejected["cogvideox-5b"]
+    assert {x["id"] for x in select.choose("image", CPU, {})["rejected"]} == {"sdxl-turbo"}             # non-commercial: never selectable
+    opted = select.choose("ti2v", GPU8, {"accepted_conditional_licenses": ["ltx-2"]})
+    assert "ltx-2" not in {x["id"] for x in opted["rejected"]}
+    assert "hunyuanvideo-1.5" in {x["id"] for x in opted["rejected"]}             # territory opt-in is separate
+    both = select.choose("ti2v", GPU8, {"accept_territory_restricted_models": True, "accepted_conditional_licenses": ["hunyuanvideo-1.5"]})
+    assert "hunyuanvideo-1.5" not in {x["id"] for x in both["rejected"]}
+
+
+def test_authorised_free_gpu_changes_where_better_models_could_run():
+    r = select.choose("t2v", CPU, {"compute": {"kaggle": True}})
+    assert "kaggle" in r["tiers"]
+    better = {b["model"]: b["could_run_on"] for b in r["better_with"]}
+    assert better["wan22-ti2v-5b"] == ["kaggle"] and better["mochi-1"] == ["no free tier - too large"]
+    assert r["model"] == "animatediff-lightning-4step"                           # still the only one with a working adapter
